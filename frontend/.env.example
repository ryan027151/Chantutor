# Copy this file to .env and fill in your values.
# Never commit .env — it contains real secrets.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Signup codes are NO LONGER stored here.
# They are validated server-side by the create-account edge function.
# Add STUDENT_CODE and ADMIN_CODE as Supabase secrets:
#   supabase secrets set STUDENT_CODE=your_student_code
#   supabase secrets set ADMIN_CODE=your_admin_code
